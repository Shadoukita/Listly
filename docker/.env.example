# Copy this file to .env (in the same docker/ folder) and fill in your values.

# REQUIRED. The container will not start without it.
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
# Anyone who knows this value can forge a login for any account, including admin.
SECRET_KEY=

# HOST_PORT: the port exposed on your machine (default 8080)
# PORT:      the port the app listens on inside the container (default 5000)
# Usually you only need to change HOST_PORT.
HOST_PORT=8080
# PORT=5000

# Number of reverse proxies in front of Listly. Leave at 0 unless you run
# behind nginx/Traefik/Caddy — setting it when you shouldn't lets clients
# spoof their IP via X-Forwarded-For and evade login throttling.
# TRUSTED_PROXY_COUNT=0

# Send HTTP Strict-Transport-Security. Only enable if you serve over HTTPS —
# on a plain-HTTP LAN install this will make browsers refuse to connect.
# ENABLE_HSTS=0

# Comma-separated allowed origins for cross-origin API access. Leave unset:
# Listly serves its own frontend, so it is same-origin and needs no CORS.
# CORS_ORIGINS=
