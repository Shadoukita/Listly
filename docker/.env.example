# Copy this file to .env (in the same docker/ folder) and fill in your values.
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# HOST_PORT: the port exposed on your machine (default 8080)
# PORT:      the port the app listens on inside the container (default 5000)
# Usually you only need to change HOST_PORT.
HOST_PORT=8080
# PORT=5000
